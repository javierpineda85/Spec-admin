<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /Spec-admin/

  # Sirve archivos/carpetas reales tal cual
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Pretty -> index.php?r=...
  RewriteRule ^(.+)$ index.php?r=$1 [QSA,L]
</IfModule>

